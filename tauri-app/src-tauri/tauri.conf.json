{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExpenseHelper",
  "version": "2.0.1",
  "identifier": "com.frankfika.expensehelper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "报销助手",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "AI 智能发票识别与报销整理",
    "longDescription": "AI 驱动的发票识别工具，支持多 Provider 一键切换、自动分类、智能配对、Excel 报表导出。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../web_app.py": "web_app.py",
      "../../app": "app"
    }
  }
}
